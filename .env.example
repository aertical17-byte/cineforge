# ---- CineForge AI environment template (copy to .env; never commit real values) ----
ENVIRONMENT=development
JWT_SECRET=generate-64-random-chars
CORS_ORIGINS=http://localhost:3000

# database
# local dev default (sqlite):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# production example:
# DATABASE_URL=postgresql+asyncpg://cineforge:cineforge@db:5432/cineforge

# storage: local (dev/CI) or s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI providers — OPTIONAL; unset keys make related engines fail with an explicit,
# honest "provider_not_configured" status. Never commit keys.
# REPLICATE_API_TOKEN=
# FAL_KEY=

# AI Horde — FREE community generation, no key needed (github.com/Haidra-org/AI-Horde).
# Anonymous tier: ~512px images, ~1 concurrent job, slower queue. Default key is ten zeros.
AIHORDE_ENABLED=true
# AIHORDE_API_KEY=0000000000
# Stripe (optional). Unset → admin-managed billing mode.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=

# admin allowlist (comma separated emails auto-granted admin at registration)
ADMIN_EMAILS=admin@cineforge.test

FREE_SIGNUP_CREDITS=200
